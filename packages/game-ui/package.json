{
  "name": "@regicide/game-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/global.css"
  },
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json",
    "lint": "pnpm run lint:js && pnpm run lint:css",
    "lint:css": "stylelint \"src/**/*.css\" --cache --cache-location .stylelintcache",
    "lint:fix": "pnpm run lint:js:fix && pnpm run lint:css:fix",
    "lint:css:fix": "stylelint \"src/**/*.css\" --cache --cache-location .stylelintcache --fix",
    "lint:js": "eslint src --cache --cache-location .eslintcache",
    "lint:js:fix": "eslint src --cache --cache-location .eslintcache --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@regicide/game-application": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
