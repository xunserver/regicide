{
  "name": "regicide",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @regicide/game-core --filter @regicide/game-application test",
    "test:coverage": "pnpm --filter @regicide/game-core --filter @regicide/game-application test:coverage",
    "test:watch": "pnpm --parallel --filter @regicide/game-core --filter @regicide/game-application exec vitest",
    "prototype:logic": "jiti packages/game-application/prototypes/active-table-logic/index.ts",
    "prototype:ui": "node apps/web-prototype/server.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test:coverage && pnpm run build && pnpm run format:check",
    "play": "pnpm --filter @regicide/game-cli play"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.2",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.8.0",
    "jiti": "2.7.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0"
  }
}
